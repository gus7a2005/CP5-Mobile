rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      // perfil público: qualquer usuário autenticado pode ver, só o dono escreve
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;

      match /private/{doc} {
        // dados privados (e-mail, telefone, contatos): só o dono acessa
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /devices/{deviceId} {
        // tokens de push: só o dono gerencia (o servidor usa Admin SDK, ignora regras)
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // grupos e conversas diretas são escritos só pelo servidor (Admin SDK ignora regras)
    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /directConversations/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
